GROQ_API_KEY=your_groq_api_key_here

# Comma-separated list of allowed frontend origins for CORS.
# Defaults to the local Vite dev server if unset.
# FRONTEND_ORIGIN=http://localhost:5173

# Set to "false" in production to disable Flask's debugger.
# Defaults to "true" (safe for local dev only).
# FLASK_DEBUG=true

# HOST=127.0.0.1
# PORT=5000

# Only set these once actually deployed behind a real reverse proxy — the
# exact IP of that proxy (waitress only trusts X-Forwarded-For if the request
# arrives directly from this address) and how many proxy hops to trust in the
# header. Leaving TRUSTED_PROXY_IP unset means all forwarded-IP headers are
# ignored, which is the safe default for local dev.
# TRUSTED_PROXY_IP=127.0.0.1
# TRUSTED_PROXY_COUNT=1

# Set to "true" only if this app terminates TLS itself. Most hosting
# platforms terminate HTTPS at a load balancer in front of the app instead —
# forcing it here too would cause a redirect loop. Leave unset/false unless
# you've confirmed which is true for your deployment.
# FORCE_HTTPS=false
